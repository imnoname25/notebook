{
  "name": "notebook-android-client",
  "version": "0.6.0",
  "type": "module",
  "private": true,
  "scripts": {
    "sync": "cap sync android",
    "check": "node scripts/validate-client.mjs && node scripts/check-server-url.mjs",
    "build:debug": "npm run sync && cd android && gradlew.bat assembleDebug",
    "build:release": "npm run sync && cd android && gradlew.bat assembleRelease bundleRelease"
  },
  "dependencies": {
    "@capacitor/android": "8.5.0",
    "@capacitor/core": "8.5.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.0",
    "typescript": "^7.0.2"
  }
}
