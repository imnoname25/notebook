# Docker Compose / Unraid production deployment.
COMPOSE_PROJECT_NAME=notebook
NOTEBOOK_IMAGE=ghcr.io/metroom/notebook:latest
POSTGRES_IMAGE=postgres:17-alpine
NOTEBOOK_NETWORK=notebook-net

# Generate with: openssl rand -hex 32
# Keep this URL-safe: Compose embeds it in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-random-hex-value
POSTGRES_USER=notebook
POSTGRES_DB=notebook

# Public HTTPS origin behind the reverse proxy, without a trailing slash.
APP_ORIGIN=https://notes.example.com
NOTEBOOK_BIND_ADDRESS=0.0.0.0
NOTEBOOK_PORT=3000
TZ=Etc/UTC

# Standard Unraid identity (nobody:users). Change only to match your host setup.
PUID=99
PGID=100
UMASK=002
# Set to 1 for one startup only when repairing ownership of existing uploads/backups.
FIX_PERMISSIONS=0
DATABASE_WAIT_TIMEOUT_SECONDS=90

# Persistent host paths. Keep these on the Unraid appdata pool.
POSTGRES_DATA_PATH=/mnt/user/appdata/notebook/postgres
UPLOAD_DATA_PATH=/mnt/user/appdata/notebook/uploads
BACKUP_DATA_PATH=/mnt/user/appdata/notebook/backups

MAX_UPLOAD_SIZE_MB=10
MAX_IMPORT_SIZE_MB=250
MAX_IMPORT_UNCOMPRESSED_MB=1024

# Generate with: openssl rand -hex 32
# Required before saving WebDAV/S3 credentials. Keep the value stable across updates.
SETTINGS_ENCRYPTION_KEY=

# Local non-Docker development only; Compose constructs its own internal DATABASE_URL.
DATABASE_URL="postgresql://notebook:change-me@localhost:5432/notebook?schema=public"
UPLOAD_DIR="./data/uploads"
BACKUP_DIR="./data/backups"

# E2E uses a dedicated database and refuses to clear it without explicit confirmation.
# E2E_DATABASE_URL="postgresql://notebook:change-me@localhost:5432/notebook_e2e?schema=public"
# E2E_RESET_DATABASE="1"
# E2E_BASE_URL="http://127.0.0.1:3100"

# Optional DB-backed integration tests. The database is touched only with explicit reset permission.
# TEST_DATABASE_URL="postgresql://notebook:change-me@localhost:5432/notebook_test?schema=public"
# TEST_RESET_DATABASE="1"

# Optional FTS benchmark. URL must explicitly contain test/dev/benchmark.
# BENCHMARK_DATABASE_URL="postgresql://notebook:change-me@localhost:5432/notebook_benchmark?schema=public"
# BENCHMARK_ALLOW_WRITES="1"
